# OpenRouter API key for Gemini 3.7 Flash analysis
OPENROUTER_API_KEY=your-openrouter-key-here

# Turso database (create free at https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local development fallback (file-based SQLite)
DATABASE_URL=file:football-ai.db